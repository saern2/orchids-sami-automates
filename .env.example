# Copy to .env.local for local work. Never commit real values.

# --- Build time (NEXT_PUBLIC_* values are inlined into the bundle) ---

# Public URL of the deployed site, no trailing slash. Used for
# metadataBase, Open Graph URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (https://<ref>.supabase.co). Also used by next.config.ts
# to allow images from the project's public storage bucket.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Read-only in practice: RLS exposes published rows only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Runtime, server only (never sent to the browser) ---

# Supabase service-role key. Used by server actions and /api/admin/* to write content.
SUPABASE_SERVICE_ROLE_KEY=

# The one email address allowed into /admin (compared case-insensitively).
ADMIN_EMAIL=

# n8n webhook that receives contact-form submissions via /api/contact.
CONTACT_WEBHOOK_URL=

# --- Local only (do NOT add on Hostinger) ---

# Postgres connection string used by `npm run db:migrate`. Use the Session
# pooler string from Supabase -> Connect (IPv4 compatible).
SUPABASE_DB_URL=
