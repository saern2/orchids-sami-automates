# Server-side only. n8n webhook that receives contact-form submissions.
# The browser never sees this URL; /api/contact forwards to it.
CONTACT_WEBHOOK_URL=

# Public URL of the deployed site, no trailing slash. Used for
# metadataBase, Open Graph URLs, robots.txt and sitemap.xml.
# Must be set at BUILD time (NEXT_PUBLIC_ variables are inlined).
NEXT_PUBLIC_SITE_URL=
